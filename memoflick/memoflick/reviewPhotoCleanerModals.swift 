// MARK: - 场景 1: 组清理完成弹窗
struct BatchCompleteModal: View {
    var onContinue: () -> Void
    var onReview: () -> Void

    var body: some View {
        VStack(spacing: 0) {
            // 图标
            ZStack {
                Circle()
                    .fill(Color.green.opacity(0.1))
                    .frame(width: 64, height: 64)

                Image(systemName: "checkmark.circle.fill")
                    .resizable()
                    .aspectRatio(contentMode: .fit)
                    .frame(width: 32, height: 32)
                    .foregroundColor(.green)
            }
            .padding(.top, 24)
            .padding(.bottom, 16)

            // 标题
            Text("整理完成！")
                .font(.system(size: 20, weight: .bold))
                .foregroundColor(.primary)
                .padding(.bottom, 8)

            // 内容
            Text("这组照片已处理完毕。\n您刚刚清理了 42 MB 的空间。")
                .font(.subheadline)
                .foregroundColor(.secondary)
                .multilineTextAlignment(.center)
                .lineSpacing(4)
                .padding(.bottom, 24)

            // 按钮组
            VStack(spacing: 12) {
                // 主按钮：继续下一组
                Button(action: onContinue) {
                    Text("继续下一组")
                        .font(.headline)
                        .foregroundColor(.white)
                        .frame(maxWidth: .infinity)
                        .padding(.vertical, 16)
                        .background(Color.blue)
                        .cornerRadius(20)
                        .shadow(color: Color.blue.opacity(0.3), radius: 8, x: 0, y: 4)
                }

                // 次要按钮：回顾删除的回忆
                Button(action: onReview) {
                    Text("回顾删除的回忆")
                        .font(.subheadline.weight(.medium))
                        .foregroundColor(.blue)
                        .frame(maxWidth: .infinity)
                        .padding(.vertical, 12)
                        .background(Color.blue.opacity(0.05)) // 轻微的背景色增加可点击感
                        .cornerRadius(16)
                }
            }
            .padding(.horizontal, 24)

            // 底部提示
            Text("今日剩余额度: 1 组")
                .font(.caption2)
                .foregroundColor(.gray.opacity(0.6))
                .padding(.top, 16)
                .padding(.bottom, 24)
        }
        .background(.ultraThinMaterial) // iOS 原生毛玻璃材质
        .cornerRadius(32)
        .padding(.horizontal, 40)
        .shadow(color: .black.opacity(0.15), radius: 20, x: 0, y: 10)
    }
}

// MARK: - 场景 2: 每日限额 / Pro 引导弹窗
struct LimitReachedModal: View {
    var onUpgrade: () -> Void
    var onCancel: () -> Void

    var body: some View {
        ZStack {
            // 背景光效装饰
            GeometryReader { proxy in
                Circle()
                    .fill(Color.yellow.opacity(0.2))
                    .frame(width: 150, height: 150)
                    .blur(radius: 40)
                    .offset(x: proxy.size.width - 50, y: -50)

                Circle()
                    .fill(Color.purple.opacity(0.2))
                    .frame(width: 150, height: 150)
                    .blur(radius: 40)
                    .offset(x: -50, y: proxy.size.height - 50)
            }
            .frame(maxWidth: .infinity, maxHeight: .infinity) // 限制在弹窗内

            // 弹窗主要内容
            VStack(spacing: 0) {
                // 皇冠图标
                ZStack {
                    Circle()
                        .fill(
                            LinearGradient(
                                colors: [Color.orange.opacity(0.1), Color.yellow.opacity(0.2)],
                                startPoint: .topLeading,
                                endPoint: .bottomTrailing
                            )
                        )
                        .frame(width: 72, height: 72)

                    Image(systemName: "crown.fill")
                        .font(.system(size: 36))
                        .foregroundColor(.yellow)
                        .shadow(color: .orange.opacity(0.5), radius: 2, x: 0, y: 2)
                }
                .padding(.top, 32)
                .padding(.bottom, 16)

                // 标题
                Text("今日额度已用完")
                    .font(.title3.bold())
                    .foregroundColor(.primary)
                    .padding(.bottom, 8)

                // 副标题
                Text("普通用户每日仅限整理 3 组照片。\n升级 ")
                    .font(.subheadline)
                    .foregroundColor(.secondary)
                    .multilineTextAlignment(.center)
                    + Text("Pro 会员").font(.subheadline.bold()).foregroundColor(.orange)
                    + Text(" 享受无限畅删。").font(.subheadline).foregroundColor(.secondary)

                // 权益列表
                VStack(alignment: .leading, spacing: 14) {
                    BenefitRow(text: "无限照片清理")
                    BenefitRow(text: "无限视频清理")
                    BenefitRow(text: "新功能优先体验") // 已修改文案
                }
                .padding(20)
                .background(Color(uiColor: .secondarySystemBackground).opacity(0.5))
                .cornerRadius(16)
                .padding(.top, 24)
                .padding(.bottom, 24)
                .padding(.horizontal, 24)

                // 升级按钮
                Button(action: onUpgrade) {
                    HStack {
                        Text("立即升级 Pro")
                        Image(systemName: "arrow.right")
                    }
                    .font(.headline)
                    .foregroundColor(.white) // 使用白色文字对比度更高
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 16)
                    .background(
                        LinearGradient(colors: [Color.black, Color(uiColor: .darkGray)], startPoint: .top, endPoint: .bottom)
                    )
                    .cornerRadius(20)
                    .shadow(color: .black.opacity(0.2), radius: 10, x: 0, y: 5)
                    // 模拟微光效果 overlay (可选)
                    .overlay(
                        RoundedRectangle(cornerRadius: 20)
                            .stroke(Color.white.opacity(0.1), lineWidth: 1)
                    )
                }
                .padding(.horizontal, 24)

                // 放弃按钮
                Button(action: onCancel) {
                    Text("明天继续免费整理")
                        .font(.footnote.weight(.medium))
                        .foregroundColor(.secondary) // 灰色弱化
                        .padding(.vertical, 16)
                }
            }
        }
        .background(.regularMaterial) // 背景虚化材质
        .cornerRadius(32)
        .padding(.horizontal, 32)
        // 确保弹窗不会太高，自适应内容
        .fixedSize(horizontal: false, vertical: true)
        .shadow(color: .black.opacity(0.2), radius: 30, x: 0, y: 15)
    }
}

